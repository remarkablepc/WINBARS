@echo off
setlocal
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo Elevating to Administrator...
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Start-Process cmd.exe -ArgumentList '/c `"%~f0`"' -Verb RunAs"
    exit /b
)
echo ============================================================
echo   WINBARS - BACKUP DRIVE VISIBILITY TOGGLE (EXPLORER CLOAK)
echo ============================================================
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$scriptDrive = '%~d0'.TrimEnd(':\').ToUpper(); $targetDrive = ''; if ($scriptDrive -and $scriptDrive -ne 'C') { $targetDrive = $scriptDrive } else { $found = Get-CimInstance Win32_LogicalDisk -ErrorAction SilentlyContinue | Where-Object { $_.DriveType -in @(2, 3) -and $_.DeviceID -ne 'C:' -and ((Test-Path ($_.DeviceID + '\Backup_Logs\Run-ZeroFootprintSync.ps1')) -or (Test-Path ($_.DeviceID + '\.winbars_target')) -or (Test-Path ($_.DeviceID + '\_DeletedArchive')) -or (Test-Path ($_.DeviceID + '\README_RECOVERY.txt'))) } | Select-Object -First 1; if ($found) { $targetDrive = $found.DeviceID.TrimEnd(':\').ToUpper() } else { try { $task = Get-ScheduledTask -TaskName 'UserProfileSync' -TaskPath '\WindowsBackup\' -ErrorAction SilentlyContinue; if ($task -and $task.Actions.Arguments -match '([A-Za-z]):\\Backup_Logs') { $targetDrive = $matches[1].ToUpper() } } catch { } } }; if (-not $targetDrive -or $targetDrive -eq 'C') { $cands = Get-CimInstance Win32_LogicalDisk -ErrorAction SilentlyContinue | Where-Object { $_.DriveType -in @(2, 3) -and $_.DeviceID -ne 'C:' }; if ($cands) { Write-Host 'Detected available external/secondary drives:'; foreach ($cd in $cands) { Write-Host ('  [' + $cd.DeviceID + '] ' + $cd.VolumeName) }; $inL = Read-Host 'Enter backup drive letter to toggle (e.g. D, E)'; if ($inL -match '^[A-Za-z]$') { $targetDrive = $inL.ToUpper() } } }; if (-not $targetDrive -or $targetDrive -eq 'C') { Write-Host '[ERROR] No external backup drive found to toggle. Cannot cloak system drive C:.' -ForegroundColor Red; Read-Host 'Press Enter to exit...'; exit }; $usb = $targetDrive; $bit = 1 -shl ([int][char]$usb - [int][char]'A'); $reg = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer'; if (-not (Test-Path $reg)) { New-Item -Path $reg -Force | Out-Null }; $curr = (Get-ItemProperty -Path $reg -Name 'NoDrives' -ErrorAction SilentlyContinue).NoDrives; if ($null -eq $curr) { $curr = 0 }; $isHidden = (($curr -band $bit) -eq $bit); if ($isHidden) { $newVal = $curr -band (-bnot $bit); if ($newVal -eq 0) { Remove-ItemProperty -Path $reg -Name 'NoDrives' -ErrorAction SilentlyContinue } else { Set-ItemProperty -Path $reg -Name 'NoDrives' -Value $newVal -Type DWord -Force }; Write-Host ('Backup Drive ' + $usb + ': is now VISIBLE in Windows Explorer.') -ForegroundColor Green } else { $newVal = $curr -bor $bit; Set-ItemProperty -Path $reg -Name 'NoDrives' -Value $newVal -Type DWord -Force; Write-Host ('Backup Drive ' + $usb + ': is now CLOAKED (hidden) in Windows Explorer.') -ForegroundColor Magenta }; Write-Host ''; $ans = Read-Host 'Restart Windows Explorer now to apply immediately? (Y/n) [Default: Y]'; if ($ans -ne 'n' -and $ans -ne 'N') { Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 800; if (-not (Get-Process -Name explorer -ErrorAction SilentlyContinue)) { Start-Process explorer.exe }; Write-Host 'Explorer restarted.' -ForegroundColor Green }; Read-Host 'Press Enter to exit...'"
